{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureFoundry": {
    "Endpoint": "<your-foundry-endpoint>",
    "ApiKey": "<set with dotnet user-secrets>",
    "ChatDeployment": "gpt-4.1-mini",
    "EmbeddingDeployment": "text-embedding-3-small",
    "ImageDeployment": "gpt-image-1-mini"
  },
  "AzureAISearch": {
    "Endpoint": "https://search-kodify-rag.search.windows.net",
    "ApiKey": "<set with dotnet user-secrets>",
    "KnowledgeIndexName": "rag-knowledge"
  },
  "AzureStorage": {
    "ConnectionString": "<set with dotnet user-secrets>",
    "DocumentsContainer": "documents"
  },
  "Rag": {
    "ChunkSize": 1600,
    "ChunkOverlap": 250
  }
}
